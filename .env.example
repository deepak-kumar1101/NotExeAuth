# ==============================================================================
# Not Exe (NXE) Frontend Environment Variables (.env.example)
# Copy this file to .env and populate with your own project credentials.
# ==============================================================================

# Master Database Encryption Secret (AES-256)
VITE_DB_SECRET="NotExeSecretKey_2026!#"

# Firebase Realtime Database & Authentication Configuration
VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKeyHere"
VITE_FIREBASE_AUTH_DOMAIN="your-notexe-project.firebaseapp.com"
VITE_FIREBASE_DATABASE_URL="https://your-notexe-project-default-rtdb.firebaseio.com"
VITE_FIREBASE_PROJECT_ID="your-notexe-project"
VITE_FIREBASE_STORAGE_BUCKET="your-notexe-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# Super Admin Email (Granted full bypass and platform control in /admin)
VITE_ADMIN_EMAIL="admin@yourdomain.com"

# Cloudflare Turnstile Bot Protection Site Key
# For Localhost Testing (Always passes automatically):
VITE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
# For Production: Replace with your Cloudflare Turnstile Site Key:
# VITE_TURNSTILE_SITE_KEY="0x4AAAAAAFi1odtuZ6QtGdVS"

# Backend API Endpoint URL (Leave empty in local dev to proxy through Vite, or set your production URL)
VITE_API_URL="https://your-notexe-worker.pages.dev"
